# Copy this file to .env, then add your own key. Never commit .env.
# The first key that is set is used: OpenAI, then Anthropic, then OpenRouter.
# With no key, ShruTea still analyzes pitch and uses local coaching.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Optional model overrides.
# SHRUTEA_COACH_MODEL=gpt-4o-mini
# SHRUTEA_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# SHRUTEA_CLAUDE_MODEL=claude-opus-5
# SHRUTEA_OPENROUTER_MODEL=anthropic/claude-haiku-4.5
